# Environment: dev or prod
ENV=dev

# Database Connection
# SECURITY NOTE: Each credential is stored as a separate environment variable
# for better security and flexibility. This allows:
# - Individual credential rotation without modifying the connection string
# - Different configurations for dev/prod/test environments
# - Easier integration with secret management systems
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aura_db
POSTGRES_HOST=db  # Use 'db' for Docker, 'localhost' for local development
POSTGRES_PORT=5432
# The DATABASE_URL is constructed from the individual components above
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Connection (Cache & Celery)
REDIS_URL=redis://redis:6379/0

# Object Storage (S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aura-uploads
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Security
ADMIN_TOKEN=replace_with_secure_token

# AI Provider (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# AI Model Versioning
MODEL_VERSION=v1-mock
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Site URL (Optional)
SITE_URL=http://localhost:5173

# Monitoring (Optional)
SENTRY_DSN=
