# Environment: dev or prod
ENV=dev

# Database Connection
# Use 'db' as host for Docker, 'localhost' for local shell
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db/aura_db

# Redis Connection (Cache & Celery)
# Use 'redis' as host for Docker, 'localhost' for local shell
REDIS_URL=redis://redis:6379/0

# Object Storage (S3 Compatible)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=aura-uploads
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Security
ADMIN_TOKEN=secret-admin-token

# AI Model Versioning
MODEL_VERSION=v1
# AI Provider (DeepSeek)
DEEPSEEK_API_KEY=sk-e3a7eb41114d4584b3356c5cef84c6ae
DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_API_KEY=... (Deprecated)
SITE_URL=http://localhost:5173

# Monitoring (Optional)
SENTRY_DSN=
