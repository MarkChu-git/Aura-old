# ==========================================
# AURA PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
# Usage:
# 1. basic: cp .env.example .env
# 2. secure: cp .env.example /home/deploy/aura-secrets.env

# --- Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aura_db
# Internal service name from docker-compose
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis Configuration ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Valid CORS origins (comma separated)
BACKEND_CORS_ORIGINS=["http://localhost", "https://your-domain.com"]

# --- AI Provider (DeepSeek) ---
# DeepSeek API Key (Required for AI features)
DEEPSEEK_API_KEY=
# Model name (e.g., deepseek-chat, deepseek-coder)
DEEPSEEK_MODEL=deepseek-chat

# --- Optional External Services ---
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=aura-uploads
# S3_ENDPOINT=
