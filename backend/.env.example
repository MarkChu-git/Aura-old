# Environment: dev or prod
ENV=dev

# Database Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aura_db
# Use 'db' as host within Docker network, 'localhost' if running locally
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db/${POSTGRES_DB}

# Redis Connection (Cache & Celery)
REDIS_URL=redis://redis:6379/0

# Object Storage (S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aura-uploads
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Security
ADMIN_TOKEN=replace_with_secure_token

# AI Provider (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# AI Model Versioning
MODEL_VERSION=v1-mock
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Site URL (Optional)
SITE_URL=http://localhost:5173

# Monitoring (Optional)
SENTRY_DSN=
